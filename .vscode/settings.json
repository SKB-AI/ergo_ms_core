{
    "terminal.integrated.defaultProfile.windows": "Project-Shell",
    "terminal.integrated.defaultProfile.linux": "Project-Shell",
    "terminal.integrated.profiles.windows": {
        "Project-Shell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "args": ["-NoExit", "-File", "${workspaceFolder}/core/deployment/windows/init_terminal.ps1"]
        },
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "args": ["-NoExit", "-Command", "& { if (Test-Path '${workspaceFolder}\\virtual_env\\python\\Scripts\\Activate.ps1') { & '${workspaceFolder}\\virtual_env\\python\\Scripts\\Activate.ps1' } }"]
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": ["/k", "${workspaceFolder}\\virtual_env\\python\\Scripts\\activate.bat"],
            "icon": "terminal-cmd"
        }
    },
    "terminal.integrated.profiles.linux": {
        "Project-Shell": {
            "path": "/bin/bash",
            "icon": "terminal-bash",
            "args": ["-c", "source '${workspaceFolder}/core/deployment/linux/init_terminal.sh' && exec bash"]
        },
        "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash",
            "args": ["-c", "source ${workspaceFolder}/virtual_env/python/bin/activate && exec bash"]
        },
        "zsh": {
            "path": "/bin/zsh",
            "icon": "terminal-bash",
            "args": ["-c", "source ${workspaceFolder}/virtual_env/python/bin/activate && exec zsh"]
        }
    },
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.focusMode": "singleClick",
    "terminal.integrated.tabs.showActions": "always",
    "terminal.integrated.tabs.title": "${processName}",
    "terminal.integrated.tabs.description": "${cwd}",
    "terminal.integrated.splitCwd": "workspaceRoot",
    
    "files.exclude": {
        "**/.git": false,
        "**/.DS_Store": true,
        "**/.*": false
    },
    "search.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/virtual_env": true
    },
    "npm.autoDetect": "off",

    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "tsconfig.json": "tsconfig.*.json, env.d.ts",
      "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
      "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .prettier*, prettier*, .editorconfig, .npmrc",
      "pyproject.toml": "poetry.lock"
    },
    "python.defaultInterpreterPath": "${env:ERGO_PYTHON_INTERPRETER}",
    "terminal.integrated.env.linux": {
        "ERGO_PYTHON_INTERPRETER": "${workspaceFolder}/virtual_env/python/bin/python3.12",
        "PATH": "${workspaceFolder}/core/deployment/bin:${env:PATH}"
    },
    "terminal.integrated.env.windows": {
        "ERGO_PYTHON_INTERPRETER": "${workspaceFolder}\\virtual_env\\python\\Scripts\\python.exe",
        "PATH": "${workspaceFolder}\\core\\deployment\\bin;${env:PATH}"
    },
    "python.terminal.activateEnvironment": true,
    "git.detectSubmodules": true,
    "git.autoRepositoryDetection": true,
    "git.detectSubmodulesLimit": 100,

    // SSH-окно не должно пробрасывать порты сервера на localhost (конфликт с локальным Start All).
    "remote.autoForwardPorts": false,
    "remote.autoForwardPortsSource": "process",
    "remote.restoreForwardedPorts": false,
    "remote.otherPortsAttributes": {
        "onAutoForward": "ignore"
    },
    // Cursor не открывает встроенный браузер на localhost-ссылки и обнаруженные порты.
    // Саму вкладку Browser Tab выключают install-extensions и ERGO MS User Config (state.vscdb).
    "workbench.browser.openLocalhostLinks": false,
    "remote.portsAttributes": {
        "*": { "onAutoForward": "ignore" },
        "80": { "onAutoForward": "ignore" },
        "6379": { "onAutoForward": "ignore" },
        "8000": { "onAutoForward": "ignore" },
        "8003": { "onAutoForward": "ignore" },
        "8004": { "onAutoForward": "ignore" },
        "11434": {
            "label": "Ollama",
            "onAutoForward": "ignore"
        }
    }
}