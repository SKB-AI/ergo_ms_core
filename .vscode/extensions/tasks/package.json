{
  "name": "ergo-ms-tasks",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.4.8",
  "publisher": "ergo-ms",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onTaskType:multi-terminal",
    "onTaskType:ergo-module"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ergo-ms-tasks.run",
        "title": "%command.run.title%"
      },
      {
        "command": "ergo-ms-tasks.runFromFile",
        "title": "%command.runFromFile.title%"
      },
      {
        "command": "ergo-ms-tasks.stopAll",
        "title": "%command.stopAll.title%"
      }
    ],
    "taskDefinitions": [
      {
        "type": "multi-terminal",
        "required": [],
        "properties": {
          "terminals": {
            "type": "array",
            "description": "%task.multiTerminal.terminals%",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "%task.multiTerminal.terminals.name%"
                },
                "command": {
                  "type": "string",
                  "description": "%task.multiTerminal.terminals.command%"
                },
                "cwd": {
                  "type": "string",
                  "description": "%task.multiTerminal.terminals.cwd%"
                }
              }
            }
          },
          "source": {
            "type": "object",
            "description": "%task.multiTerminal.source%",
            "properties": {
              "provider": {
                "type": "string",
                "description": "%task.multiTerminal.source.provider%"
              },
              "target": {
                "type": "string",
                "description": "%task.multiTerminal.source.target%"
              },
              "file": {
                "type": "string",
                "description": "%task.multiTerminal.source.file%"
              },
              "path": {
                "type": "string",
                "description": "%task.multiTerminal.source.path%"
              }
            }
          },
          "sources": {
            "type": "array",
            "description": "%task.multiTerminal.sources%",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "description": "%task.multiTerminal.sources.provider%"
                },
                "target": {
                  "type": "string",
                  "description": "%task.multiTerminal.sources.target%"
                },
                "file": {
                  "type": "string",
                  "description": "%task.multiTerminal.sources.file%"
                },
                "path": {
                  "type": "string",
                  "description": "%task.multiTerminal.sources.path%"
                },
                "commandTemplate": {
                  "type": "string",
                  "description": "%task.multiTerminal.sources.commandTemplate%"
                },
                "nameTemplate": {
                  "type": "string",
                  "description": "%task.multiTerminal.sources.nameTemplate%"
                }
              }
            }
          },
          "commandTemplate": {
            "type": "string",
            "description": "%task.multiTerminal.commandTemplate%"
          },
          "stopCommandTemplate": {
            "type": "string",
            "description": "%task.multiTerminal.stopCommandTemplate%"
          },
          "nameTemplate": {
            "type": "string",
            "description": "%task.multiTerminal.nameTemplate%"
          },
          "group": {
            "type": "string",
            "description": "%task.multiTerminal.group%"
          },
          "delay": {
            "type": "number",
            "description": "%task.multiTerminal.delay%",
            "default": 300
          },
          "hideControlTerminal": {
            "type": "boolean",
            "description": "%task.multiTerminal.hideControlTerminal%",
            "default": false
          },
          "launchAs": {
            "type": "string",
            "enum": ["task", "terminal"],
            "description": "%task.multiTerminal.launchAs%",
            "default": "task"
          }
        }
      },
      {
        "type": "ergo-module",
        "required": [
          "label",
          "detail",
          "command"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "%task.ergoModule.label%"
          },
          "detail": {
            "type": "string",
            "description": "%task.ergoModule.detail%"
          },
          "command": {
            "type": "string",
            "description": "%task.ergoModule.command%"
          },
          "module": {
            "type": "string",
            "description": "%task.ergoModule.module%"
          },
          "panel": {
            "type": "string",
            "description": "%task.ergoModule.panel%",
            "enum": [
              "shared",
              "new"
            ],
            "default": "shared"
          }
        }
      }
    ]
  }
}
