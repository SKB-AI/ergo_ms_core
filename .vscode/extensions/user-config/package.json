{
  "name": "ergo-ms-user-config",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.2.4",
  "publisher": "ergo-ms",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": ["ui", "workspace"],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.vscode/user_settings.json",
    "workspaceContains:.vscode/user_keybindings.json"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ergo-ms-user-config.applySettings",
        "title": "%command.applySettings.title%"
      },
      {
        "command": "ergo-ms-user-config.applyKeybindings",
        "title": "%command.applyKeybindings.title%"
      },
      {
        "command": "ergo-ms-user-config.applyAll",
        "title": "%command.applyAll.title%"
      },
      {
        "command": "ergo-ms-user-config.removeKeybindings",
        "title": "%command.removeKeybindings.title%"
      },
      {
        "command": "ergo-ms-user-config.removeSettings",
        "title": "%command.removeSettings.title%"
      },
      {
        "command": "ergo-ms-user-config.installLocal",
        "title": "%command.installLocal.title%"
      }
    ]
  }
}
