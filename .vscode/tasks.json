                "file": "celery_workers.yaml",
                "path": "workers"
            },
            "commandTemplate": "ergoms start-worker --worker=${key}",
            "nameTemplate": "Celery Worker: ${key}",
            "group": "celery-workers",
            "delay": 500,
            "hideControlTerminal": true,
            "windows": {
                "options": {
                    "env": {
                        "PATH": "${workspaceFolder}\\core\\deployment\\bin;${env:Path};${env:PATH};${env:SystemRoot}\\System32;${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0"
                    }
                }
            },
            "linux": {
                "options": {
                    "env": {
                        "PATH": "${workspaceFolder}/core/deployment/bin:${env:PATH}"
                    }
                }
            }
        },
