# Репозитории ядра системы

[submodule "core/api"]
	path = core/api
	url = https://github.com/SKB-AI/ergo_ms_core_api.git
	branch = dev
	update = merge
	ignore = all

[submodule "core/client"]
	path = core/client
	url = https://github.com/SKB-AI/ergo_ms_core_client.git
	branch = dev
	update = merge
	ignore = all

[submodule "core/media_api"]
	path = core/media_api
	url = https://github.com/SKB-AI/ergo_ms_core_media_api.git
	branch = dev
	update = merge
	ignore = all

[submodule "core/.github"]
	path = core/.github
	url = https://github.com/ergoms/.github.git
	branch = dev
	update = merge
	ignore = all

