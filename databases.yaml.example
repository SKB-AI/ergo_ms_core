# Каталог подключений. Режим default задаётся ERGO_DB в .env
# (sqlite | postgres | portable_postgres | mysql | mssql) — loader выставляет engine.
# Host/user/password/port/name для SQL — здесь. Redis — секция redis (не в .env).
# setup-full создаёт databases.yaml с default; port: 5433 при ERGO_DB=portable_postgres
# (5432 при ERGO_DB=postgres). Секцию redis дописывает при ERGO_BROKER=redis,
# в том числе если файл уже был без неё (default не затирается).
# Celery SQL / analytics — допишите из example.
# Пароли в example пустые — при ERGO_DB=portable_postgres setup-full / install-postgres
# подставляет уникальные user и password, если кластер ещё не создан
# (шаблонный user postgres тоже заменяется). Существующие значения не трогает.
# Не коммитьте реальные пароли.
databases:
  default:
    engine: "postgresql"
    name: "ergo_ms"
    user: "postgres"
    password: ""
    host: "127.0.0.1"
    # 5433 — portable (ERGO_DB=portable_postgres / ergoms install-postgres);
    # 5432 — системный Postgres; MySQL обычно 3306; MSSQL — 1433
    port: 5433

  # При ERGO_BROKER=redis — кэш, channel layer и Celery.
  # В Docker host обычно remapped на имя сервиса (DOCKER_SERVICE_REDIS).
  # user/password пустые — генерируются уникальные, пока в redis.conf нет requirepass;
  # непустой password — requirepass + ACL-пользователь / redis://user:…@host
  # (не дублируйте пароль в .env как REDIS_PASSWORD).
  redis:
    engine: "redis"
    host: "127.0.0.1"
    port: 6379
    user: ""
    password: ""
    db_channel: 0
    db_cache: 1
    db_celery_broker: 2
    db_celery_result: 3

  # --- опционально (не копируются в databases.yaml при setup-full) ---

  celery:
    engine: "postgresql"
    name: "ergo_ms_celery"
    user: "celery_user"
    password: ""
    host: "127.0.0.1"
    port: 5433

  celery_worker:
    engine: "postgresql"
    name: "ergo_ms_celery_worker"
    user: "celery_worker_user"
    password: ""
    host: "127.0.0.1"
    port: 5433

  celery_beat:
    engine: "postgresql"
    name: "ergo_ms_celery_beat"
    user: "celery_beat_user"
    password: ""
    host: "127.0.0.1"
    port: 5433

  analytics:
    engine: "mysql"
    name: "world"
    user: "root"
    password: ""
    host: "127.0.0.1"
    port: 3306

  # Уровень 3: отдельная БД модуля. Поле module: — имя папки modules/<name>
  # (app_label). Router направит модели этого приложения на alias.
  # Раскомментируйте и задайте имя модуля; пароль не коммитьте.
  # module_pilot:
  #   engine: "postgresql"
  #   name: "ergo_ms_module_pilot"
  #   module: "<name>"
  #   user: ""
  #   password: ""
  #   host: "127.0.0.1"
  #   port: 5433
