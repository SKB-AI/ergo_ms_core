VERSION=3.0.0

# Язык интерфейса по умолчанию: ru | en | fr
DEFAULT_LANGUAGE=ru
# Часовой пояс Django / Celery / логов API (IANA): UTC | Europe/Moscow | …
TIME_ZONE=UTC
# Язык CLI ergoms (help и сообщения): код языка (ru/en/fr/…); пусто = системная локаль, иначе ru.
# Новый язык — каталог core/deployment/locales/<code>/ (cli_messages + overlays help).
# ERGO_CLI_LANGUAGE=

# setup-full: portable Python / Node в virtual_env
PORTABLE_PYTHON_ENABLED=true
PORTABLE_NODEJS_ENABLED=true

# --- Режимы ---
# Где крутятся процессы: host (на машине) | docker (Compose)
ERGO_RUNTIME=host
# Как пускать наружу: none (напрямую) | nginx (обратный прокси)
ERGO_PROXY=none
# Очереди, кэш и channel layer: local (память/SQLite) | redis (databases.yaml)
ERGO_BROKER=local
# Какая БД у секции default: sqlite | postgres | portable_postgres | mysql | mssql
ERGO_DB=portable_postgres
# JupyterLab: none (выкл.) | auto | local | lan | nginx
# nginx — только вместе с ERGO_PROXY=nginx
ERGO_JUPYTER=none
# Исходящая почта: none (выкл.) | smtp
ERGO_EMAIL=none
# Файлы для API: local (диск) | remote (через media_api по HTTP)
ERGO_MEDIA=local
# Доставка событий клиенту: websocket | sse | http_polling
ERGO_REALTIME=websocket
# Поиск (Meilisearch / BM25): true | false. Детали — env/search.env
ERGO_SEARCH_ENABLED=true
# Режим системы: development (разработка) | production (сервер); коротко: dev | prod
ERGO_ENV=development
# Режим разработчика: у глобального админа глазик (просмотр как пользователь,
# смена роли и прав без записи в БД). В production игнорируется.
ERGO_DEV_TOOLS=false
# Уровень безопасности (этап 2: незаданные ключи подставляет профиль в runtime;
# .env не переписывается). open | standard | hardened | maximum
ERGO_SECURITY=standard
# Реакция CLI на нарушения: off | warn | raise
ERGO_SECURITY_ENFORCE=warn
# Режим CSP (API middleware + nginx render): as_is | no_unsafe | no_unsafe_plus_externals
# (профиль: open/standard → as_is, hardened → no_unsafe, maximum → no_unsafe_plus_externals;
# unset подставляет профиль. На hardened+ без unsafe-eval/unsafe-inline карты могут не работать.)
# API_CSP_MODE=as_is
# Процессы модулей: monolith (всё в одном API) | microservice (модули — отдельные процессы)
# Детали microservice / ModuleBridge — env/modules.env (из env/modules.env.example)
MODULE_RUNTIME=monolith
# Какие службы ставить на этой машине: full (как раньше) | core (ядро без module API)
# | modules (только API/worker модулей) | auto (modules, если заданы NGINX_API_UPSTREAM,
# MICROSERVICE_MODULES и BRIDGE_CORE_URL). Детали — HOST_SERVICES в env/modules.env
HOST_PROFILE=full
# Префикс имён OS-служб (NSSM / systemd). По умолчанию ergo_ms.
# Изолированные системные тесты подставляют свой префикс, чтобы не
# пересечься с рабочей установкой. Не задавайте чужой префикс вручную,
# если на машине уже стоят службы с именами ergo_ms_*.
# ERGO_SERVICE_PREFIX=ergo_ms
# Модульность клиента: bundled (один SPA) | federated (shell + remotes) | standalone (отдельные SPA-репо)
# Детали CLIENT_MODULES / CLIENT_MODULE_REMOTES — env/modules.env
CLIENT_MODULARITY=bundled

# --- CORS ---
# Разрешённые origin'ы фронта (через запятую).
# Development: можно не задавать — подставятся localhost/127.0.0.1 на типичных портах.
# Production: если не задано, берётся публичный origin nginx (или FRONTEND_BASE_URL).
# Список портов разработки в production не подставляется. Если и runtime-origin пуст —
# API не запустится.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Standalone SPA (CLIENT_MODULARITY=standalone): добавьте origin каждого модуля, напр.
# CORS_ALLOWED_ORIGINS=https://spa-a.example.com,https://spa-b.example.com
# Либо regex вместо списка:
# CORS_ALLOWED_ORIGIN_REGEXES=^https?://localhost(:\\d+)?$
# CSRF: доверенные origin'ы для запросов с cookie (часто те же, что CORS).
# Development: можно не задавать. Production: если не задано — тот же runtime-origin, что у CORS.
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- API ---
API_HOST=localhost
API_PORT=8000
# Через запятую; * — любой хост
API_ALLOWED_HOSTS=localhost,127.0.0.1
# Автоперезапуск API при правках кода (только development)
API_AUTORELOAD=true
# Swagger / ReDoc и HTML-формы DRF: если не заданы — включаются только в development.
# Для локальной отладки можно явно включить:
# API_SWAGGER_ENABLED=true
# API_DRF_BROWSABLE_ENABLED=true
# В production оставьте выключенными или не задавайте (иначе документация API будет открыта).

# Ограничивать срок жизни JWT: true — по минутам ниже; false — без ограничения
# (false только для development; в production API не запустится)
API_JWT_LIFETIME_ENABLED=true
# Access-токен (минуты), обычный вход
API_ACCESS_TOKEN_LIFETIME=30
# Refresh-токен (минуты), обычный вход (короче кодового запасного 1440 — жёстче для сессии)
API_REFRESH_TOKEN_LIFETIME=60
# Access при «Запомнить меня» (минуты); hardened допускает не более суток
API_REMEMBER_ME_ACCESS_TOKEN_LIFETIME=1440
# Refresh при «Запомнить меня» (минуты); hardened допускает не более суток
API_REMEMBER_ME_REFRESH_TOKEN_LIFETIME=1440
# Ротация refresh при обновлении сессии включена в коде (ROTATE_REFRESH_TOKENS);
# предыдущий refresh заносится в чёрный список (BLACKLIST_AFTER_ROTATION).
# Logout отзывает текущую refresh-сессию устройства.
# Ключ подписи JWT. Пусто — setup-full и запуск служб запишут отдельный ключ.
# Вручную: ergoms generate-secret. Если пуст в runtime — берётся API_SECRET_KEY.
API_JWT_SIGNING_KEY=

# Лимит запросов для гостей (формат: число/minute|hour).
# 60/minute — чтобы F5 и boot SPA не упирались в публичные эндпоинты.
# Вход и восстановление пароля — отдельные scope 5/minute, не этот лимит.
API_THROTTLE_RATES_ANON=60/minute
# Лимит запросов для авторизованных пользователей
API_THROTTLE_RATES_USER=5000/hour
# Лимит попыток входа (дефолт кода 5/minute; раскомментируйте для переопределения)
# API_THROTTLE_RATES_LOGIN=5/minute
# Лимит запросов восстановления пароля (дефолт кода 5/minute)
# API_THROTTLE_RATES_PASSWORD_RESET=5/minute
# Лимит запросов регистрации / validate-registration (дефолт кода 5/minute)
# API_THROTTLE_RATES_REGISTRATION=5/minute
# Восстановление сессии (token-refresh по cookie); дефолт кода 60/minute
# API_THROTTLE_RATES_TOKEN_REFRESH=60/minute
# Секрет Django (подписи, сессии). Обязателен; в production — не шаблон и >= 32 символов.
# Пусто — setup-full и запуск служб запишут ключ в .env.
# Вручную: ergoms generate-secret
API_SECRET_KEY=
# Блокировка после N неудачных логинов (0 = выкл). Профиль standard/hardened/maximum подставляет 10/10/5.
# API_AUTH_LOCKOUT_MAX_ATTEMPTS=0
# API_AUTH_LOCKOUT_WINDOW_SECONDS=900
# API_AUTH_LOCKOUT_DURATION_SECONDS=900
# Срок хранения записей UserDevice в днях (0 = без автоочистки). hardened/maximum: 90/30.
# API_SESSION_DEVICE_RETENTION_DAYS=0
# Держать соединение с БД открытым N секунд; 0 — закрывать сразу
API_DATABASE_CONN_MAX_AGE=60
# Сжимать JSON-ответы API (gzip)
API_GZIP_ENABLED=true
# Проверять доступность БД при старте процессов
DATABASE_TEST_CONNECTIONS=true

# --- Регистрация и профиль ---
# Кто может регистрироваться: open (все) | invitation (по ссылке) | closed (выкл.)
# Безопасное значение по умолчанию; для самостоятельной регистрации задайте invitation или open явно.
API_REGISTRATION_MODE=closed
# Сколько дней действует ссылка-приглашение
API_REGISTRATION_INVITATION_TTL_DAYS=7
# Запрещать повторную регистрацию на тот же email
API_REGISTRATION_CHECK_EMAIL_EXISTS=true
# Разрешить «Забыл пароль» (письмо с кодом)
API_PASSWORD_RESET_ENABLED=false
# Срок жизни кода восстановления пароля (минуты)
API_PASSWORD_RESET_CODE_TTL_MINUTES=10
# Максимум неверных попыток ввода кода восстановления
API_PASSWORD_RESET_CODE_MAX_ATTEMPTS=3
# Пользователь сам меняет ФИО/email/телефон (иначе — через заявку админу)
API_USER_PROFILE_SELF_EDIT_ENABLED=true
# Авто-_view для роли «Пользователь» без ролевых групп: granted | denied
# (профиль: open/standard → granted, hardened/maximum → denied; unset подставляет профиль)
# API_ADP_DEFAULT_VIEW_GRANTS=granted
# Публичный URL клиента для ссылок в письмах (иначе CLIENT_HOST:CLIENT_PORT)
# FRONTEND_BASE_URL=https://app.example.com

# --- Политика паролей ---
# Минимальная длина пароля
API_PASSWORD_MIN_LENGTH=12
# Максимальная длина пароля
API_PASSWORD_MAX_LENGTH=128
# Требовать строчную букву
API_PASSWORD_REQUIRE_LOWERCASE=true
# Требовать заглавную букву
API_PASSWORD_REQUIRE_UPPERCASE=false
# Требовать цифру
API_PASSWORD_REQUIRE_DIGIT=true
# Требовать спецсимвол
API_PASSWORD_REQUIRE_SPECIAL=false
# Нельзя пароль, похожий на имя/email пользователя
API_PASSWORD_VALIDATE_USER_ATTRIBUTE_SIMILARITY=true
# Нельзя пароль из списка самых распространённых
API_PASSWORD_VALIDATE_COMMON_PASSWORD=true
# Нельзя пароль только из цифр
API_PASSWORD_VALIDATE_NUMERIC_ONLY=true

# --- Клиент ---
CLIENT_HOST=localhost
CLIENT_PORT=8001
# Кнопка «Отменить» в success-toast (редактор тем: стандарт, быстрый выбор, дубль и т.д.)
CLIENT_TOAST_UNDO_ENABLED=false
# Глубина стека отмен для «Стандарт системы» (1 = только последняя отмена), если CLIENT_TOAST_UNDO_ENABLED=true
CLIENT_TOAST_UNDO_STACK_MAX=3

# --- Сессии устройств ---
# Сколько секунд помнить «устройство ещё активно» без повторного запроса в БД
API_DEVICE_SESSION_CACHE_TTL=45
# Не чаще чем раз в N секунд обновлять время последней активности устройства в БД
API_DEVICE_ACTIVITY_DEBOUNCE_SEC=120

# --- Модули ---
# Отключённые модули через запятую (пример: module_name1,module_name2)
DISABLED_MODULES=

# --- Геолокация по IP ---
# Определять город/страну сессий по IP (нужна база MMDB)
GEOIP_ENABLED=false
# URL архива базы MMDB (или скачать: ergoms geoip-download)
GEOIP_DOWNLOAD_URL=https://download.db-ip.com/free/dbip-city-lite-2026-07.mmdb.gz
