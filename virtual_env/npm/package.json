{
  "name": "ergo-ms",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "ErgoMS npm workspace (client)",
  "workspaces": [
    "../../core/client"
  ],
  "scripts": {
    "dev": "python ../../core/deployment/scripts/start_client_if_dev.py",
    "stop-dev": "npm run stop-dev -w @ergo-ms/core-client",
    "build": "npm run build -w @ergo-ms/core-client",
    "build:remote": "npm run build:remote -w @ergo-ms/core-client --",
    "build:standalone": "npm run build:standalone -w @ergo-ms/core-client --",
    "pack:shell": "npm run pack:shell -w @ergo-ms/core-client",
    "preview": "npm run preview -w @ergo-ms/core-client",
    "lint": "npm run lint -w @ergo-ms/core-client",
    "lint:check": "npm run lint:check -w @ergo-ms/core-client",
    "lint:a11y": "npm run lint:a11y -w @ergo-ms/core-client",
    "check-i18n": "npm run check-i18n -w @ergo-ms/core-client",
    "format": "npm run format -w @ergo-ms/core-client",
    "postinstall": "node ../../core/deployment/scripts/sync-module-npm-deps.js --install-missing",
    "install:all": "node ../../core/deployment/scripts/sync-module-npm-deps.js --install-all",
    "e2e": "playwright test -c ../../core/client/e2e/playwright.config.js"
  },
  "script_comments": {
    "dev": "Запуск сервера разработки",
    "stop-dev": "Остановка сервера разработки",
    "build": "Сборка проекта",
    "preview": "Предварительный просмотр сборки",
    "lint": "Проверка и исправление кода с помощью ESLint",
    "lint:check": "ESLint без автофикса (ядро + modules/*/client)",
    "lint:a11y": "Проверка доступности Vue (eslint-plugin-vuejs-accessibility)",
    "format": "Форматирование кода с помощью Prettier",
    "postinstall": "Доустановка npm-зависимостей модулей и удаление пакетов вне дерева ядра и модулей без записи в package-lock.json",
    "install:all": "Установка ядра (если сменился lock или не хватает пакетов) вместе с пакетами модулей; очистка node_modules только если сменился набор прямых пакетов (без обновления package-lock.json)",
    "e2e": "Браузерные системные тесты ядра (Playwright); URL и учётка — ERGO_E2E_*"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@lucide/vue": "^1.31.0",
    "@vue/devtools-api": "^8.1.5",
    "@vuepic/vue-datepicker": "^12.0.0",
    "axios": ">=1.18.0",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "js-cookie": "^3.0.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-slicksort": "^2.0.5",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "vue-eslint-parser": "^10.3.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "1.102.0",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "@playwright/test": "^1.55.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "not dead",
    "not ie 11"
  ],
  "overrides": {
    "uuid": "14.0.1"
  }
}
