# Фрагмент Docker Compose. Копия: copy env/docker.env.example env/docker.env
# Режим: ERGO_RUNTIME=docker в корневом .env.
# Запуск: ergoms docker-init, затем ergoms docker-prod или ergoms docker-dev.

# --- Docker ---
# dev — bind-mount кода, runserver, Vite; prod — daphne, client-build
DOCKER_MODE=dev

DOCKER_COMPOSE_PROJECT=ergo_ms
DOCKER_COMPOSE_DIR=core/deployment/docker

# CORS / CSRF (корневой .env): при DOCKER_MODE=prod / ERGO_ENV=production, если списки
# не заданы, подставляется публичный origin nginx или FRONTEND_BASE_URL.
# Явный origin клиента по-прежнему можно задать:
# CORS_ALLOWED_ORIGINS=http://localhost:8001
# CSRF_TRUSTED_ORIGINS=http://localhost:8001
# или публичный URL: CORS_ALLOWED_ORIGINS=https://app.example.com
# В DOCKER_MODE=dev (ERGO_ENV=development) localhost-origins для CORS подставляются сами;
# CSRF_TRUSTED_ORIGINS можно не задавать.

# PostgreSQL: container | host (host/port/user/password/name — databases.yaml)
DOCKER_DATABASE=container

# Публикация postgres/redis/meilisearch на хост (внутри compose: 5432/6379/7700).
# На хост всегда 127.0.0.1, не все интерфейсы.
# Postgres/Meilisearch: пусто = опубликовать, если порт свободен; none = не публиковать; число = порт.
# Redis: пусто или none = не публиковать (opt-in); число = порт на хосте.
# Jupyter (profile): порт на хост только 127.0.0.1:API_JUPYTER_BIND_PORT.
# DOCKER_POSTGRES_PUBLISH_PORT=
# DOCKER_REDIS_PUBLISH_PORT=
# DOCKER_MEILI_PUBLISH_PORT=

# Profiles (true/false)
DOCKER_PROFILE_NGINX=false
# По умолчанию из ERGO_JUPYTER (≠none); можно задать явно:
DOCKER_PROFILE_JUPYTER=false
# По умолчанию из ERGO_DB (postgres/portable_postgres); можно задать явно:
DOCKER_PROFILE_POSTGRES=true
# Изолированный Postgres+API для loadtest (ergoms docker-loadtest-up / --docker-isolated):
DOCKER_PROFILE_LOADTEST=false
# LOADTEST_API_PORT=18000
# LOADTEST_POSTGRES_PORT=15432
# LOADTEST_POSTGRES_DB=ergo_ms_loadtest
# Профиль Meilisearch (BM25): по умолчанию из ERGO_SEARCH_ENABLED; можно задать явно:
# DOCKER_PROFILE_MEILISEARCH=true

# DOCKER_PYTHON_IMAGE=ergo_ms-python:local
# DOCKER_NODE_IMAGE=node:20-bookworm-slim
# DOCKER_NGINX_IMAGE=nginx:1.27-alpine
# DOCKER_REDIS_IMAGE=redis:7-alpine
# DOCKER_POSTGRES_IMAGE=postgres:16-alpine

DOCKER_SERVICE_API=api
DOCKER_SERVICE_MEDIA=media-api
DOCKER_SERVICE_REDIS=redis
DOCKER_SERVICE_POSTGRES=postgres

DOCKER_VOLUME_LOGS=bind
DOCKER_VOLUME_MEDIA=bind
# Overlay/история celery-balance — в этом томе (CELERY_BALANCE* из env/celery.env)
DOCKER_VOLUME_CELERY_CACHE=named
# DOCKER_REDIS_PERSIST=false

DOCKER_BUILD_CACHE=true
DOCKER_DEPS_CACHE=internal
DOCKER_BUILD_POLICY=if-missing
DOCKER_NPM_INSTALL=smart
