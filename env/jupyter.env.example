# Фрагмент JupyterLab. Копия: copy env/jupyter.env.example env/jupyter.env
# Режим: ERGO_JUPYTER=auto|local|lan|nginx в корневом .env (none — выкл.).
# Запуск: ergoms start-jupyter / Start All Services при ERGO_JUPYTER не none.
# Режим nginx требует ERGO_PROXY=nginx в корневом .env.

# --- Jupyter ---
# API_JUPYTER_ACCESS_MODE обычно не нужен — берётся из ERGO_JUPYTER.
# Явный override access mode (local | lan | nginx | auto):
# API_JUPYTER_ACCESS_MODE=auto

# Legacy только для ERGO_JUPYTER=auto: true — пускать Jupyter за nginx.
# При ERGO_JUPYTER=nginx не нужен (и false здесь не отменяет режим).
API_JUPYTER_BEHIND_NGINX=false
API_JUPYTER_ALLOW_REMOTE=false
# Явный bind (пусто — из режима: local→localhost, lan→0.0.0.0, nginx→127.0.0.1)
API_JUPYTER_BIND_HOST=
API_JUPYTER_BIND_PORT=8002
# Базовый путь за nginx (только режим nginx)
API_JUPYTER_BASE_PATH=/jupyter/
# Явный публичный URL (override; пусто — из режима и nginx)
API_JUPYTER_URL=
# Токен — обязателен для lan и nginx. Пусто — setup-full и start-jupyter запишут.
# Вручную: ergoms generate-secret
API_JUPYTER_TOKEN=
API_JUPYTER_TRUST_XHEADERS=true
