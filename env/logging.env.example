# Фрагмент логирования системы. Копия: copy env/logging.env.example env/logging.env
# Каталог по умолчанию — logs/ в корне проекта. Загружается вместе с остальными env/*.env.

# --- Клиент: DevTools, ошибки на сервер, мониторинг сессий ---
# Уровень в DevTools: debug, info, warn, error, critical, silent
# Не влияет на запись ошибок на сервер (CLIENT_BROWSER_LOG_*).
CLIENT_LOG_LEVEL=debug

# Отправка ошибок клиента на сервер → logs/client-browser.log (POST /api/cms/client-log/)
CLIENT_BROWSER_LOG_ENABLED=true

# Сессионный мониторинг (навигация, API, ошибки) → БД + админка /admin-panel/client-monitor
# Vite bake-in: после смены флага пересоберите клиент (ergoms client-build / restart Vite).
CLIENT_MONITORING_ENABLED=false
CLIENT_MONITORING_RETENTION_DAYS=7
CLIENT_MONITORING_LOG_FILE_ENABLED=true
CLIENT_MONITORING_BATCH_MAX=100
# Ручной purge: ergoms api client_monitor_purge [--days N] [--dry-run]

# --- Аудит ---
AUDIT_ASYNC_PERSIST=false
AUDIT_ASYNC_PERSIST_FALLBACK_SYNC=true
AUDIT_RETENTION_DAYS=0
AUDIT_LOG_FILE_ENABLED=true
# AUDIT_LOG_FILE_LEVEL=info
# Ручной purge: ergoms api audit_purge [--days N] [--dry-run]

# --- Уровни и каталог ---
# Файлы пишутся всегда; консоль служб отключена (ERGO_LOG_CONSOLE=false в systemd/NSSM).
# ERGO_LOGS_DIR=
# info — рабочий режим: access «GET /path HTTP/1.1» 200 в api.log, без DEBUG Daphne/environ.
# debug — подробная отладка (environ, внутренности); access при этом тоже остаётся.
ERGO_LOG_FILE_LEVEL=info
ERGO_LOG_CONSOLE_LEVEL=info
# ERGO_LOG_CONSOLE=true

# --- Ротация: Python-сервисы (API, Celery, media_api) ---
# ERGO_LOG_MAX_BYTES=10485760
# ERGO_LOG_BACKUP_COUNT=5
# ERGO_LOG_BROKER_MAX_BYTES=5242880
# ERGO_LOG_BROKER_BACKUP_COUNT=3

# --- Ротация: nginx, Redis, Vite, LLM serve, Jupyter, Meilisearch, CLI ---
# ERGO_LOG_INFRA_ROTATE_ENABLED=true
# ERGO_LOG_INFRA_MAX_BYTES=10485760
# ERGO_LOG_INFRA_BACKUP_COUNT=5
# ERGO_LOG_NGINX_MAX_BYTES=
# ERGO_LOG_NGINX_BACKUP_COUNT=
# ERGO_LOG_REDIS_MAX_BYTES=
# ERGO_LOG_REDIS_BACKUP_COUNT=
# ERGO_LOG_CLIENT_DEV_MAX_BYTES=
# ERGO_LOG_CLIENT_DEV_BACKUP_COUNT=
# Сжатие нумерованных копий (*.log.1 → *.log.1.gz). false — оставить как есть.
# ERGO_LOG_COMPRESS=true
# Удалять копии старше N дней (0 — только по числу копий).
# ERGO_LOG_RETENTION_DAYS=14
# hourly — каждый час; daily — раз в сутки в ERGO_LOG_INFRA_ROTATE_HOUR.
# ERGO_LOG_INFRA_ROTATE_INTERVAL=hourly
# ERGO_LOG_INFRA_ROTATE_HOUR=3
# ergoms logs-status — сколько занимает logs/; ergoms rotate-logs — вручную
# ergoms install-infra-log-rotate — cron / Task Scheduler

# --- Имена файлов (basename в ERGO_LOGS_DIR; необязательно) ---
# ERGO_LOG_FILE_API=api.log
# ERGO_LOG_FILE_MEDIA_API=media_api.log
# ERGO_LOG_FILE_CELERY=celery.log
# ERGO_LOG_FILE_CELERY_WORKER=celery_worker.log
# ERGO_LOG_FILE_CELERY_BEAT=celery_beat.log
# ERGO_LOG_FILE_CELERY_TASKS=celery_tasks.log
# ERGO_LOG_FILE_CELERY_BROKER=celery_broker.log
# ERGO_LOG_FILE_NGINX_ACCESS=nginx-access.log
# ERGO_LOG_FILE_NGINX_ERROR=nginx-error.log
# ERGO_LOG_FILE_REDIS=redis.log
# ERGO_LOG_FILE_CLIENT_DEV=client-dev.log
# ERGO_LOG_FILE_CLIENT_BROWSER=client-browser.log
# ERGO_LOG_FILE_CLIENT_MONITOR=client-monitor.log
# ERGO_LOG_FILE_AUDIT=audit.log
# ERGO_LOG_FILE_MEILISEARCH=meilisearch.log
# ERGO_LOG_FILE_OLLAMA=ollama-serve.log
# ERGO_LOG_FILE_JUPYTER=jupyter.log
# ERGO_LOG_FILE_SETUP_FULL=setup-full.log
# ERGO_LOG_FILE_ERGOMS=ergoms.log

# --- Уровни по компонентам (fallback: ERGO_LOG_FILE_LEVEL) ---
# API_LOG_FILE_LEVEL=debug
# API_LOG_CONSOLE_LEVEL=info
# API_LOG_CONSOLE=true
# CELERY_LOG_FILE_LEVEL=debug
# CELERY_LOG_CONSOLE=false
# CELERY_BEAT_LOG_FILE_LEVEL=debug
# MEDIA_API_LOG_FILE_LEVEL=debug
# MEDIA_API_LOG_CONSOLE=false

# --- Уровни отдельных файлов (переопределяют *_LOG_FILE_LEVEL компонента) ---
# ERGO_LOG_LEVEL_CELERY_BROKER=info
# ERGO_LOG_LEVEL_CLIENT_BROWSER=warning
# ERGO_LOG_LEVEL_CLIENT_MONITOR=info
# ERGO_LOG_LEVEL_AUDIT=info

# --- Vite / nginx / Redis ---
# CLIENT_DEV_LOG_ENABLED=true
# CLIENT_DEV_LOG_LEVEL=info
# NGINX_ERROR_LOG_LEVEL=warn
# NGINX_ACCESS_LOG_ENABLED=true
# REDIS_LOG_LEVEL=notice

# --- Прочее ---
# Полные списки модулей и очередей при ergoms start-worker / start-beat (или --verbose)
# ERGO_CELERY_STARTUP_VERBOSE=false
