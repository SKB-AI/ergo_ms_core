# Фрагмент поиска (Meilisearch / BM25). Копия: copy env/search.env.example env/search.env
# Режим: ERGO_SEARCH_ENABLED=true|false в корневом .env.
# При false или недоступности Meili — запасной вариант icontains/trigram.

# URL Meilisearch для API (в Docker — http://meilisearch:7700)
# Порт 8004 — следующий после API(8000)/client(8001)/jupyter(8002)/media(8003)
MEILI_HOST=http://127.0.0.1:8004
MEILI_HTTP_ADDR=127.0.0.1:8004

# Master key (обязателен в production; не попадает в клиент).
# Пусто — setup-full и запуск поиска запишут. Вручную: ergoms generate-secret
MEILI_MASTER_KEY=

# Docker Compose (опционально; внутри сети контейнер слушает 7700).
# Публикация на хост — DOCKER_MEILI_PUBLISH_PORT в env/docker.env (пусто = auto по MEILI_HTTP_ADDR).
# На хост публикуется 127.0.0.1, не 0.0.0.0.
# DOCKER_MEILI_IMAGE=getmeili/meilisearch:v1.43.1
