# Фрагмент Celery. Копия: copy env/celery.env.example env/celery.env
# Очередь по умолчанию следует ERGO_BROKER (auto).

# Очередь задач: auto (из ERGO_BROKER) | redis | database | local (SQLite)
CELERY_BROKER_BACKEND=auto
# Свои URL брокера и результатов (иначе — databases.yaml)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/2
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# Балансировщик слотов worker: auto (overlay при старте) | recommend (отчёт) | off (только celery_workers.yaml)
CELERY_BALANCE=auto
# Резерв RAM под ОС, если измеренных процессов недостаточно (МБ)
# CELERY_BALANCE_OS_RESERVE_RAM_MB=1024
# Ядра CPU вне Celery (API, БД, redis, nginx)
# CELERY_BALANCE_RESERVE_CPU=1
# Жёсткие границы concurrency
# CELERY_BALANCE_MIN_CONCURRENCY=1
# CELERY_BALANCE_MAX_CONCURRENCY=
# GPU-probe (nvidia-smi): auto | off
CELERY_BALANCE_GPU=auto
# Не добавлять GPU-слоты, если средняя загрузка карт не ниже этого процента
# CELERY_BALANCE_GPU_UTIL_CAP=80
# Интервал --watch, секунды
# CELERY_BALANCE_WATCH_INTERVAL=30
# Доля изменения concurrency, ниже которой --watch не трогает пул (0.2 = 20%)
# CELERY_BALANCE_HYSTERESIS=0.2

