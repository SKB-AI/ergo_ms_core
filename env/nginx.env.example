# Фрагмент nginx / TLS. Копия: copy env/nginx.env.example env/nginx.env
# Режим: ERGO_PROXY=nginx в корневом .env. Установка: ergoms install-nginx, install-tls.
# При ERGO_PROXY=nginx клиент сам ходит на API/WebSocket с того же origin (relative).
# Явный override (туннели без nginx и т.п.):
# CLIENT_USE_RELATIVE_API=true

# --- Nginx ---
# При ERGO_PROXY=nginx setup-full ставит nginx; start-client не поднимает Vite;
# API/Media на 127.0.0.1. Доступ по IP: NGINX_SERVER_NAME=localhost (IP определится сам).
NGINX_PUBLIC_HOST=
NGINX_LISTEN_HOST=0.0.0.0
NGINX_SERVER_NAME=localhost
NGINX_LISTEN_PORT=80
# NGINX_ALT_HOSTS=
NGINX_HOST_POLICY=allow
NGINX_USE_HTTPS=false
# CSP для nginx и API — один ключ API_CSP_MODE в корневом .env (см. .env.example).
# as_is | no_unsafe | no_unsafe_plus_externals; при unset подставляет профиль ERGO_SECURITY.

# Запас к max(MEDIA_UPLOAD_MAX_SIZE, TASKS_MAX_ATTACHMENT_SIZE_MB, …)
# при рендере client_max_body_size (ergoms install-nginx / reload-nginx).
# NGINX_UPLOAD_BODY_MARGIN_PERCENT=10

# TLS (домен; по IP Let's Encrypt не выдаёт сертификат):
# ERGO_TLS_EMAIL=admin@example.com
# ERGO_TLS_DOMAINS=app.example.com,www.app.example.com
# ERGO_TLS_WEBROOT=
# ERGO_TLS_STAGING=false
# ERGO_SSL_CERT=
# ERGO_SSL_KEY=
# SECURE_SSL_REDIRECT=false
# Куда host-nginx шлёт общий /api/ и /ws/ (логин, меню, ядро).
# Пусто — 127.0.0.1:API_PORT. Location /api/<module>/ из MICROSERVICE_MODULES
# этот ключ не меняет. На ядре в API_ALLOWED_HOSTS и CSRF_TRUSTED_ORIGINS
# должен быть публичный origin этого nginx (браузерный Host).
# NGINX_API_UPSTREAM=core.internal:8000

# Куда host-nginx шлёт оболочку клиента (/, /index.html, /assets/, /client-build.json).
# Пусто — локальный core/client/dist. Задайте host:port, если SPA собрана
# на другом хосте, а люди открывают этот nginx. Location /api/ и /ws/ не меняет.
# На том хосте в server_name / NGINX_PUBLIC_HOST должен быть адрес из этого ключа
# (прокси ставит Host равным ему). В compose ключ не читается.
# NGINX_CLIENT_UPSTREAM=modules.internal:80

# Куда host-nginx шлёт /remotes/<name>/ (federated remoteEntry).
# Пусто — местный virtual_env/client-remotes/. На ядре, если remotes
# собирают на хосте модулей, укажите nginx пира (порт 80 по умолчанию).
# NGINX_CLIENT_REMOTES_UPSTREAM=modules.internal:80

# Куда host-nginx шлёт только /upload/<module>/ и /serve/<module>/
# (имена из MICROSERVICE_MODULES или NGINX_MEDIA_UPSTREAM_MODULES).
# Общий /upload/ и /serve/ (аватары, файлы ядра) всегда местный media_api.
# Пусто — префиксы модулей тоже местные. На ядре, если файлы модулей
# лежат на другом хосте (HOST_MEDIA=on там), укажите nginx пира
# (порт 80 по умолчанию).
# NGINX_MEDIA_UPSTREAM=10.0.0.8:80
# NGINX_MEDIA_UPSTREAM_MODULES=

# CORS — в корневом .env (CORS_ALLOWED_ORIGINS)
