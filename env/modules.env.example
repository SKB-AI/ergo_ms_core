# Фрагмент модулей, ModuleBridge и модульности клиента.
# Копия: copy env/modules.env.example env/modules.env
# MODULE_RUNTIME / CLIENT_MODULARITY задаются в корневом .env.

# --- Клиент: allow-list и federation ---
# CSV модулей в бандл (пусто = все кроме DISABLED_MODULES). Для bundled и federated host.
# На хосте только вынесенных модулей перечислите их здесь: чужие страницы
# не попадут в сборку. Не ставьте эти имена в DISABLED_MODULES на ядре —
# меню отдаёт API ядра, и пункты пропадут на обоих сайтах.
CLIENT_MODULES=
# Страницы модуля не в этом бандле: <name>=/remotes/<name>/remoteEntry.js
# (тот же origin; nginx ядра проксирует /remotes/ на хост модулей).
# Папка modules/<name>/ на ядре не нужна.
# ergoms client-build читает роль хоста: оболочку собирает, если этот nginx
# отдаёт местный core/client/dist (нет NGINX_CLIENT_UPSTREAM и HOST_PROFILE
# не modules). Remotes собирает, если этот хост отдаёт
# virtual_env/client-remotes (нет NGINX_CLIENT_REMOTES_UPSTREAM) и на диске
# есть modules/<name>/client — из MICROSERVICE_MODULES и CLIENT_MODULE_REMOTES.
CLIENT_MODULE_REMOTES=
# Shared для Module Federation (через запятую)
CLIENT_FEDERATION_SHARED=vue,vue-router,pinia

# --- Роль хоста (HOST_PROFILE задаётся в корневом .env) ---
# Явный список служб вместо профиля: api,client,media,beat,yaml_workers,module_api,module_worker,module_beat
# Пусто — взять набор из HOST_PROFILE.
# HOST_SERVICES=
# media: on | off | auto (auto выключает media при ERGO_MEDIA=remote)
# on — файлы модулей этого хоста. Токен для target_dir <name>/… выдаёт
# процесс модуля (/api/<name>/media/upload-token/), не ядро. Ядро и его
# модули на другом сервере по-прежнему грузят в свой media_api.
# HOST_MEDIA=
# Worker: yaml (ключи celery_workers.yaml) | modules (install-module-service) | none
# HOST_CELERY_WORKERS=
# Процесс модуля: full (все apps ядра) | slim (платформенный минимум + extras)
MODULE_PROCESS_PROFILE=full
# CSV dotted path поверх slim, например src.core.search
# MODULE_PROCESS_CORE_EXTRA=
# Модуль может добавить extras в api/process_profile.yaml (поле core_apps).

# --- Список вынесенных API-модулей (только при MODULE_RUNTIME=microservice) ---
# CSV имён папок modules/<name>
# OS-службы API/worker/beat этих модулей (install-module-service) ставит install-services
# только если MODULE_RUNTIME=microservice, имя есть в этом списке
# и HOST_PROFILE допускает module_api / module_worker / module_beat.
# Beat модуля нужен, если у модуля есть celery_beat_config.py: на хосте ядра
# общего Celery Beat нет расписания вынесенного модуля.
MICROSERVICE_MODULES=

# Роль процесса: api | beat | module:<name> | (пусто для worker — все модули)
# ERGO_PROCESS_ROLE=api
# Явный allow-list modules.* для процесса (перекрывает фильтр MICROSERVICE_MODULES)
# PROCESS_MODULES=

# Порт/хост модуля на машине (<NAME> = имя модуля в UPPERCASE + _PORT / _HOST)
# <NAME>_PORT=8123
# <NAME>_HOST=127.0.0.1

# --- ModuleBridge ---
# Транспорт ops: local (монолит) | http (RPC между процессами)
# http нужен и без MODULE_RUNTIME=microservice: локальные ops остаются
# in-process, отсутствующие идут на URL из BRIDGE_SERVICE_URLS.
BRIDGE_TRANSPORT=local
# Шина событий: local | redis (нужен Redis при microservice)
BRIDGE_EVENT_BUS=local
# Shared secret для /internal/bridge/* (заголовок X-Bridge-Token).
# Одинаковый на всех хостах одной связки. Мост принимает loopback
# и private/link-local при BRIDGE_TRANSPORT=http или MODULE_RUNTIME=microservice|split.
# Nginx режет /internal/ с публичного входа: в карте указывайте адрес
# прослушивания Django (внутренняя сеть), не публичный сайт.
# При MODULE_RUNTIME=microservice пусто — setup-full и запуск служб запишут.
# Вручную: ergoms generate-secret
BRIDGE_INTERNAL_TOKEN=
# Карта URL: <name>=http://127.0.0.1:8123,<other>=http://peer.example:8000
# Ключ <name> удовлетворяет integrations.yaml requires, даже если папки
# modules/<name>/ нет на этом хосте. Не дублируйте чужой модуль
# в MICROSERVICE_MODULES — иначе nginx будет искать его локальный процесс.
# Пример: траектории здесь, студенты на другом сервере —
# BRIDGE_SERVICE_URLS=students=http://peer.example:8000
BRIDGE_SERVICE_URLS=
# Соседи на этой машине без HTTP: auto | on | off
# auto — при BRIDGE_TRANSPORT=http loopback и тот же хост грузятся в процесс;
# URL на другом сервере по-прежнему HTTP. off — как раньше, все remote по HTTP.
# BRIDGE_COLOCATE=auto
# URL ядра для обратных вызовов из module-процессов
BRIDGE_CORE_URL=
# Таймаут HTTP bridge (сек)
BRIDGE_HTTP_TIMEOUT=10
# Повторы HTTP-моста при 5xx / сетевой ошибке (4xx не повторяем)
BRIDGE_HTTP_RETRIES=2
# Лимит служебного /internal/bridge/* (count/period)
# Лимит служебного /internal/bridge/* на этом процессе (count/period).
# На ядре при jwt_claims поставьте не ниже 600/minute: все модули одного хоста
# делят один IP. session.device_active и adp.* лимит не считают.
BRIDGE_INTERNAL_RATE=600/minute
# Redis DB для bridge EventBus
BRIDGE_REDIS_DB=4

# Изоляция модулей: off | warn | raise
BRIDGE_ISOLATION=warn
# Проверка схем дескрипторов моста: off | warn | raise
BRIDGE_CONTRACTS=warn
# Вход на процессе модуля: orm (читает auth_user) | jwt_claims (уровень 3, principal из JWT).
# Роль и ролевые группы процесс модуля всё равно спрашивает на ядре, если задан
# BRIDGE_CORE_URL. Без URL ядра остаётся локальная cms_adp_* (на чужой БД все
# выглядят как один пользователь). На уровне 3 ставьте jwt_claims.
MODULE_AUTH_MODE=orm
# Исходящий интернет для OS-служб (Celery worker/Beat). Если с консоли hh.ru
# открывается, а служба отвечает net::ERR_ADDRESS_UNREACHABLE — задайте тот же
# прокси, что в сессии пользователя. Пусто — служба ходит напрямую.
# HTTP_PROXY=http://127.0.0.1:1080
# HTTPS_PROXY=http://127.0.0.1:1080
# ALL_PROXY=http://127.0.0.1:1080
# Внутренний HTTP (мост, пакеты справки, /serve/knowledge/):
# false — не использовать HTTP_PROXY; true — HTTP_PROXY и NO_PROXY из окружения.
ERGO_HTTP_TRUST_ENV=false
# Хосты вне прокси: loopback, ядро, media. systemd дописывает адреса из
# BRIDGE_* / MEDIA_API_* / ALLOWED_HOSTS в wrappers/ergo_ms.env.
# NO_PROXY=localhost,127.0.0.1,::1,core.internal
# no_proxy=localhost,127.0.0.1,::1,core.internal

# --- Standalone SPA (CLIENT_MODULARITY=standalone) ---
# CORS: добавьте origin'ы SPA в корневой CORS_ALLOWED_ORIGINS
# Пример: https://spa-a.example.com,https://spa-b.example.com
# nginx: отдельные server_name / root на каждый dist модуля; /api/ → общий gateway
