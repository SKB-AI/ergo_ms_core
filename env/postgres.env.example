# Фрагмент portable PostgreSQL. Копия: copy env/postgres.env.example env/postgres.env
# Режим: ERGO_DB=portable_postgres в корневом .env.
# Host/port/credentials — только в databases.yaml (не дублировать здесь).
# После смены knobs: ergoms install-postgres (перезапишет postgresql.conf).
#
# Профиль по умолчанию: 4 ядра / 8 потоков, 16 ГБ RAM, SSD
# (shared ~25% RAM, effective_cache ~75%, parallel = числу потоков).

# --- Служба ОС ---
POSTGRES_SERVICE_WINDOWS=ergo_ms_postgres
POSTGRES_SERVICE_LINUX=ergo_ms_postgres
POSTGRES_SERVICE_DISPLAY_NAME=Ergo MS - PostgreSQL
POSTGRES_SERVICE_RESTART_DELAY_MS=5000
# Пользователь systemd. Пусто — владелец каталога data (не root: сервер так не стартует).
# POSTGRES_SERVICE_USER=

# --- Нагрузка postgresql.conf (память) ---
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=4GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=12GB

# --- SSD и параллелизм (8 потоков) ---
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_MAX_WORKER_PROCESSES=8
POSTGRES_MAX_PARALLEL_WORKERS=8
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=4
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=4

# --- WAL (массовые UPDATE / COPY) ---
# Больше max_wal_size — реже checkpoint. lz4 — если сборка с liblz4; иначе setup пишет pglz.
POSTGRES_MAX_WAL_SIZE=2GB
POSTGRES_WAL_COMPRESSION=lz4
