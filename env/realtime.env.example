# Фрагмент realtime. Копия: copy env/realtime.env.example env/realtime.env
# Транспорт: ERGO_REALTIME=websocket|sse|http_polling в корневом .env
# (явный REALTIME_TRANSPORT перекрывает ERGO_REALTIME).
# Channel layer без явного CHANNEL_LAYER_BACKEND следует ERGO_BROKER.

# REALTIME_TRANSPORT=websocket

# Интервал keepalive для SSE, сек
# REALTIME_SSE_KEEPALIVE_INTERVAL=25

# Где хранить канал между процессами (иначе: redis при ERGO_BROKER=redis, иначе memory)
# CHANNEL_LAYER_BACKEND=memory
# CHANNEL_LAYER_BACKEND=postgres
# CHANNEL_LAYER_BACKEND=redis
# Свой URL Redis для каналов (иначе — databases.yaml)
# CHANNEL_LAYER_REDIS_URL=redis://127.0.0.1:6379/0

# Как часто опрашивать «кто онлайн», сек (режим http_polling)
REALTIME_POLL_PRESENCE_INTERVAL=45
# Как часто опрашивать новые уведомления, сек
REALTIME_POLL_NOTIFICATIONS_INTERVAL=15
# Как часто опрашивать присутствие в админке, сек
REALTIME_POLL_ADMIN_PRESENCE_INTERVAL=10
# Как часто опрашивать сообщения мессенджера, сек
REALTIME_POLL_MESSENGER_INTERVAL=5

# Максимальный размер входящего WebSocket-кадра, байты (дефолт кода 262144 = 256 KiB)
# API_REALTIME_MAX_MESSAGE_BYTES=262144
