# Фрагмент SMTP. Копия: copy env/smtp.env.example env/smtp.env
# Режим: ERGO_EMAIL=smtp в корневом .env (none — исходящая почта выкл.).
# Проверка: ergoms api test_smtp
# EMAIL_HOST_PASSWORD задайте вручную (в example пусто).

# --- SMTP ---
# EMAIL_ENABLED обычно не нужен — берётся из ERGO_EMAIL.
# EMAIL_ENABLED=true

EMAIL_HOST_USER=mail
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
# Отображаемое имя отправителя (опционально):
# DEFAULT_FROM_EMAIL="ERGOMS <info@example.com>"
# HELO/EHLO при SMTP (не hostname VPS *.twc1.net — иначе DBL_SPAM у фильтров):
# EMAIL_LOCAL_HOSTNAME=crm-ms-eco.ru

# Пауза перед письмом notification (сек). 300 = 5 мин; 0 = сразу. Даёт окно для recall.
NOTIFICATIONS_EMAIL_DELAY_SECONDS=300
