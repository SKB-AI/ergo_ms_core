maintenance.flag

# Фрагменты окружения: шаблоны *.example в git, рабочие env/*.env — локально
/env/*
!/env/*.example

# Локальный Python venv с именем venv/ (не путать с /env/)
venv/

*.log
__pycache__/

/virtual_env/celery/*
!/virtual_env/celery/.gitkeep

/virtual_env/python/*
!/virtual_env/python/.gitkeep

